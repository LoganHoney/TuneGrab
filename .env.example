# Copy to .env and fill in. Only MUSIC_PATH is required.

# ---- required ---------------------------------------------------------------
# Your music folder on this machine (the one Navidrome/Jellyfin already use)
MUSIC_PATH=/srv/media/music

# ---- basics -----------------------------------------------------------------
# User/group that owns MUSIC_PATH: `ls -ln /srv/media/music` shows the numbers
PUID=1000
PGID=1000
PORT=8095
TZ=Etc/UTC

# ---- Navidrome (optional, recommended) --------------------------------------
# Enables rescans after downloads, curated playlists, suggestions and the Cleanup tab.
# On the same machine as TuneGrab, use http://host.docker.internal:4533
NAVIDROME_URL=
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# ---- Jellyfin (optional) -----------------------------------------------------
# Rescan after downloads. API key: Jellyfin Dashboard -> API Keys
JELLYFIN_URL=
JELLYFIN_API_KEY=

# ---- downloads (these and the suggestion settings can also be changed in the app: ☰ -> Settings) ----
AUDIO_FORMAT=mp3            # mp3, m4a or opus
AUDIO_QUALITY=0             # mp3 only: 0 = best VBR
SLEEP_MIN=5                 # random pause between tracks, in seconds,
SLEEP_MAX=15                # so YouTube doesn't rate-limit big albums
LYRICS_AUTO=true

# Where "Offload" moves songs you don't want in the library (default: ./offload)
# OFFLOAD_PATH=/srv/media/music-offload

# ---- suggestions and playlists (need Navidrome) -----------------------------
AUTO_ADD_SUGGESTIONS=3      # clean suggestions downloaded automatically per refresh; 0 = never
SUGGEST_REFRESH_HOURS=24
PLAYLIST_REFRESH_HOURS=6
